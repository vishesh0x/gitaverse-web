---
import { parts, chapters } from "../config";
const { full = false } = Astro.props;
// The chapters page has a single h1, so part headings are h2 there and h3 where the list sits under a section heading.
const Heading = full ? "h2" : "h3";
---

<div class:list={["parts", { full }]}>
  {
    parts.map((p) => (
      <div class="part rise">
        <Heading class="ph">
          {p.title.replace(/^Part \d: /, "")}
          <span lang="sa">{p.subtitle.split(" · ")[0]}</span>
        </Heading>
        <ol>
          {chapters
            .filter((c) => c.number >= p.fromChapter && c.number <= p.toChapter)
            .map((c) => (
              <li>
                <span class="n">{c.number}</span>
                <span class="nm">
                  <b>{c.englishName}</b>
                  <i lang="sa">{c.sanskritName}</i>
                </span>
                {full && <span class="sm">{c.summary}</span>}
                <span class="vc">{c.verseCount} verses</span>
              </li>
            ))}
        </ol>
      </div>
    ))
  }
</div>
